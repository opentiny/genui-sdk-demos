{
    "data": {
      "framework": "Vue",
      "materials": {
        "components": [
          {
            "name": { "zh_CN": "输入框" },
            "component": "NInput",
            "description": "通过鼠标或键盘输入字符",
            "npm": {
              "package": "naive-ui",
              "exportName": "NInput",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "输入框属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "输入框基础属性" },
                  "content": [
                    {
                      "property": "modelValue",
                      "label": { "text": { "zh_CN": "绑定值" } },
                      "description": { "zh_CN": "绑定值" },
                      "required": true,
                      "type": "string",
                      "cols": 12
                    },
                    {
                      "property": "placeholder",
                      "label": { "text": { "zh_CN": "占位文本" } },
                      "description": { "zh_CN": "输入框占位文本" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    }
                  ]
                }
              ],
              "events": {
                "onUpdate:modelValue": {
                  "label": { "zh_CN": "绑定值改变时触发" },
                  "description": { "zh_CN": "绑定值改变时触发" }
                }
              }
            }
          },
          {
            "name": { "zh_CN": "下拉选择" },
            "component": "NSelect",
            "description": "下拉选择器，从一组数据中选择",
            "npm": {
              "package": "naive-ui",
              "exportName": "NSelect",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "选择器属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "下拉选择器基础属性" },
                  "content": [
                    {
                      "property": "modelValue",
                      "label": { "text": { "zh_CN": "绑定值" } },
                      "description": { "zh_CN": "选中的值" },
                      "required": true,
                      "type": "string",
                      "cols": 12
                    },
                    {
                      "property": "placeholder",
                      "label": { "text": { "zh_CN": "占位文本" } },
                      "description": { "zh_CN": "选择框占位文本" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    },
                    {
                      "property": "options",
                      "label": { "text": { "zh_CN": "选项" } },
                      "description": { "zh_CN": "下拉选项，例如 [{\"label\":\"A\",\"value\":\"a\"},{\"label\":\"B\",\"value\":\"b\"}]" },
                      "required": true,
                      "type": "array",
                      "cols": 12
                    }
                  ]
                }
              ],
              "events": {
                "onUpdate:modelValue": {
                  "label": { "zh_CN": "选中值改变时触发" },
                  "description": { "zh_CN": "选中值改变时触发" }
                }
              }
            }
          },
          {
            "name": { "zh_CN": "按钮" },
            "component": "NButton",
            "description": "常用操作按钮",
            "npm": {
              "package": "naive-ui",
              "exportName": "NButton",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "按钮属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "按钮基础属性" },
                  "content": [
                    {
                      "property": "type",
                      "label": { "text": { "zh_CN": "按钮类型" } },
                      "description": { "zh_CN": "按钮类型" },
                      "required": false,
                      "type": "select",
                      "cols": 12,
                      "widget": {
                        "component": "SelectConfigurator",
                        "props": {
                          "options": [
                            { "label": "default", "value": "default" },
                            { "label": "primary", "value": "primary" },
                            { "label": "success", "value": "success" },
                            { "label": "warning", "value": "warning" },
                            { "label": "error", "value": "error" },
                            { "label": "info", "value": "info" }
                          ]
                        }
                      }
                    },
                    {
                      "property": "size",
                      "label": { "text": { "zh_CN": "按钮大小" } },
                      "description": { "zh_CN": "按钮大小" },
                      "required": false,
                      "type": "select",
                      "cols": 12,
                      "widget": {
                        "component": "SelectConfigurator",
                        "props": {
                          "options": [
                            { "label": "small", "value": "small" },
                            { "label": "medium", "value": "medium" },
                            { "label": "large", "value": "large" }
                          ]
                        }
                      }
                    },
                    {
                      "property": "disabled",
                      "label": { "text": { "zh_CN": "禁用" } },
                      "description": { "zh_CN": "是否禁用按钮" },
                      "required": false,
                      "type": "boolean",
                      "cols": 12,
                      "widget": {
                        "component": "CheckBoxConfigurator",
                        "props": {}
                      }
                    }
                  ]
                }
              ],
              "events": {
                "onClick": {
                  "label": { "zh_CN": "点击时触发" },
                  "description": { "zh_CN": "点击时触发" }
                }
              }
            }
          },
          {
            "name": { "zh_CN": "表单" },
            "component": "NForm",
            "description": "表单容器，用于校验和收集表单数据",
            "npm": {
              "package": "naive-ui",
              "exportName": "NForm",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "表单属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "表单基础属性" },
                  "content": [
                    {
                      "property": "labelPlacement",
                      "label": { "text": { "zh_CN": "标签位置" } },
                      "description": { "zh_CN": "标签位置" },
                      "required": false,
                      "type": "select",
                      "cols": 12,
                      "widget": {
                        "component": "SelectConfigurator",
                        "props": {
                          "options": [
                            { "label": "left", "value": "left" },
                            { "label": "top", "value": "top" }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": { "zh_CN": "表单项" },
            "component": "NFormItem",
            "description": "表单行，包裹单个表单项",
            "npm": {
              "package": "naive-ui",
              "exportName": "NFormItem",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "表单项属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "表单项基础属性" },
                  "content": [
                    {
                      "property": "label",
                      "label": { "text": { "zh_CN": "标签" } },
                      "description": { "zh_CN": "表单项标签" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    },
                    {
                      "property": "path",
                      "label": { "text": { "zh_CN": "字段路径" } },
                      "description": { "zh_CN": "对应表单数据的字段路径，例如 user.name" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    },
                    {
                      "property": "required",
                      "label": { "text": { "zh_CN": "必填" } },
                      "description": { "zh_CN": "是否必填" },
                      "required": false,
                      "type": "boolean",
                      "cols": 12,
                      "widget": {
                        "component": "CheckBoxConfigurator",
                        "props": {}
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": { "zh_CN": "卡片" },
            "component": "NCard",
            "description": "信息展示卡片容器",
            "npm": {
              "package": "naive-ui",
              "exportName": "NCard",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "卡片属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "卡片基础属性" },
                  "content": [
                    {
                      "property": "title",
                      "label": { "text": { "zh_CN": "标题" } },
                      "description": { "zh_CN": "卡片标题" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": { "zh_CN": "图标" },
            "component": "NIconSvg",
            "description": "图标组件，name 为图标名，例如 SearchOutline、AddOutline",
            "schema": {
              "properties": [
                {
                  "name": "0",
                  "label": { "zh_CN": "基础属性" },
                  "content": [
                    {
                      "property": "name",
                      "label": { "text": { "zh_CN": "图标名称" } },
                      "description": { "zh_CN": "图标名称，例如 SearchOutline（搜索）、AddOutline（加号）" },
                      "required": true,
                      "type": "string",
                      "cols": 12,
                      "widget": { "component": "SelectIconConfigurator", "props": {} }
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": { "zh_CN": "图标容器" },
            "component": "NIcon",
            "description": "图标容器，用于包裹 SVG 图标",
            "npm": {
              "package": "naive-ui",
              "exportName": "NIcon",
              "destructuring": true
            },
            "schema": {
              "properties": [
                {
                  "name": "图标容器属性",
                  "label": { "zh_CN": "基础属性" },
                  "description": { "zh_CN": "图标容器基础属性" },
                  "content": [
                    {
                      "property": "size",
                      "label": { "text": { "zh_CN": "图标大小" } },
                      "description": { "zh_CN": "图标大小，例如 20px" },
                      "required": false,
                      "type": "string",
                      "cols": 12
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
